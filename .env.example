# ==============================================================================
# Google Gemini AI Configuration
# ==============================================================================
# Google Gemini API Key (Required for Phase 3 text chat, Phase 5 browser voice, & Phase 6 telephony)
GEMINI_API_KEY=

# Gemini Models
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live

# ==============================================================================
# Phase 6 Telephony Integration (Twilio Media Streams)
# ==============================================================================
# Local port for the standalone WebSocket telephony bridge server
TELEPHONY_PORT=8080

# Public HTTPS URL exposing the Next.js API / Webhooks (Port 3000)
# Example: https://app-tunnel.ngrok-free.app (or your public web domain)
# Twilio Voice Webhook points to: https://PUBLIC_HTTP_BASE_URL/api/telephony/twilio/voice
PUBLIC_HTTP_BASE_URL=

# Public WSS / WebSocket URL exposing the Telephony Bridge Server (Port 8080)
# Example: https://ws-tunnel.ngrok-free.app (or wss://ws-tunnel.ngrok-free.app)
# Twilio <Connect><Stream> forks caller audio to: wss://PUBLIC_WS_BASE_URL/api/telephony/twilio-stream
PUBLIC_WS_BASE_URL=

# Twilio Account Credentials (Optional in local dev, REQUIRED for live PSTN calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Cost protection: Maximum duration per telephone call in seconds (default: 300 = 5 minutes)
MAX_CALL_DURATION_SECONDS=300
